{
  "name": "freecode-zoom-connector",
  "version": "1.0.1",
  "description": "Zoom API connector — schedule, start, end, and manage meetings. View meeting recordings, participants, and user profiles via Zoom REST API. Uses OAuth 2.0 with local token storage.",
  "author": {
    "name": "FreeCode",
    "email": "support@freecode.ai"
  },
  "homepage": "https://freecode.ai",
  "license": "MIT",
  "keywords": ["zoom", "meetings", "video", "connector", "api", "scheduling"],
  "category": "connectors",
  "tags": ["zoom", "meetings", "productivity", "connector"],
  "user_config": {
    "ZOOM_ACCOUNT_ID": {
      "description": "Zoom account ID from the Zoom developer portal",
      "required": true,
      "secret": false
    },
    "ZOOM_CLIENT_ID": {
      "description": "OAuth Client ID from Zoom App Marketplace",
      "required": true,
      "secret": true
    },
    "ZOOM_CLIENT_SECRET": {
      "description": "OAuth Client Secret from Zoom App Marketplace",
      "required": true,
      "secret": true
    },
    "ZOOM_TOKEN_FILE": {
      "description": "Path to stored OAuth token (default: ~/.freecode/.zoom-token.json)",
      "required": false,
      "secret": false,
      "default": "~/.freecode/.zoom-token.json"
    }
  },
  "mcpServers": {
    "zoom-api": {
      "command": "node",
      "args": ["${FREECODE_PLUGIN_ROOT}/mcp/zoom-server.js"],
      "env": {
        "ZOOM_ACCOUNT_ID": "${FREECODE_PLUGIN_OPTION_ZOOM_ACCOUNT_ID}",
        "ZOOM_CLIENT_ID": "${FREECODE_PLUGIN_OPTION_ZOOM_CLIENT_ID}",
        "ZOOM_CLIENT_SECRET": "${FREECODE_PLUGIN_OPTION_ZOOM_CLIENT_SECRET}",
        "ZOOM_TOKEN_FILE": "${FREECODE_PLUGIN_OPTION_ZOOM_TOKEN_FILE}"
      }
    }
  }
}
