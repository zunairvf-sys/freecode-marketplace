{
  "name": "freecode-teams-connector",
  "version": "1.0.1",
  "description": "Microsoft Teams connector — read/send messages, manage channels, view calendar events, and handle tasks via Microsoft Graph API. Uses OAuth 2.0 with local token storage.",
  "author": {
    "name": "FreeCode",
    "email": "support@freecode.ai"
  },
  "homepage": "https://freecode.ai",
  "license": "MIT",
  "keywords": ["teams", "microsoft", "graph", "messaging", "connector", "api"],
  "category": "connectors",
  "tags": ["teams", "microsoft", "messaging", "connector"],
  "user_config": {
    "TEAMS_TENANT_ID": {
      "description": "Azure AD Tenant ID",
      "required": true,
      "secret": false
    },
    "TEAMS_CLIENT_ID": {
      "description": "Azure AD Application (Client) ID",
      "required": true,
      "secret": true
    },
    "TEAMS_CLIENT_SECRET": {
      "description": "Azure AD Client Secret",
      "required": true,
      "secret": true
    },
    "TEAMS_TOKEN_FILE": {
      "description": "Path to stored OAuth token (default: ~/.freecode/.teams-token.json)",
      "required": false,
      "secret": false,
      "default": "~/.freecode/.teams-token.json"
    }
  },
  "mcpServers": {
    "teams-api": {
      "command": "node",
      "args": ["${FREECODE_PLUGIN_ROOT}/mcp/teams-server.js"],
      "env": {
        "TEAMS_TENANT_ID": "${FREECODE_PLUGIN_OPTION_TEAMS_TENANT_ID}",
        "TEAMS_CLIENT_ID": "${FREECODE_PLUGIN_OPTION_TEAMS_CLIENT_ID}",
        "TEAMS_CLIENT_SECRET": "${FREECODE_PLUGIN_OPTION_TEAMS_CLIENT_SECRET}",
        "TEAMS_TOKEN_FILE": "${FREECODE_PLUGIN_OPTION_TEAMS_TOKEN_FILE}"
      }
    }
  }
}
