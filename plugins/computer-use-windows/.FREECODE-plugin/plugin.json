  "platform": "win32",
  "mcpServers": {
    "computer-use-windows": {
      "command": "python",
      "args": ["${FREECODE_PLUGIN_ROOT}/mcp/server.py"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
